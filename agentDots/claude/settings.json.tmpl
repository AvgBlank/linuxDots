    "hyperframes-animation": "user-invocable-only",
    "hyperframes-audio": "user-invocable-only",
    "hyperframes-cli": "user-invocable-only",
    "hyperframes-core": "user-invocable-only",
    "hyperframes-creative": "user-invocable-only",
    "hyperframes-keyframes": "user-invocable-only",
    "hyperframes-registry": "user-invocable-only",
    "hyperframes-studio": "user-invocable-only",
    "media-use": "user-invocable-only",
    "general-video": "user-invocable-only",
    "figma-code-connect": "user-invocable-only",
    "figma-code-workflows": "user-invocable-only",
    "figma-create-new-file": "user-invocable-only",
    "figma-design-to-code": "user-invocable-only",
    "figma-generate-design": "user-invocable-only",
    "figma-generate-diagram": "user-invocable-only",
    "figma-generate-library": "user-invocable-only",
    "figma-generative-plugins": "user-invocable-only",
    "figma-implement-motion": "user-invocable-only",
    "figma-shaders": "user-invocable-only",
    "figma-spec": "user-invocable-only",
    "figma-swiftui": "user-invocable-only",
    "figma-use": "user-invocable-only",
    "figma-use-figjam": "user-invocable-only",
    "figma-use-motion": "user-invocable-only",
    "figma-use-slides": "user-invocable-only"
  },
  "statusLine": {
    "type": "command",
    "command": "__HOME__/.bun/bin/bun __HOME__/.bun/bin/ccstatusline",
    "padding": 0,
    "refreshInterval": 10
  },
  "enabledPlugins": {
    "ponytail@ponytail": true
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high",
      "autoCompactWindow": 400000
    },
    "claude-sonnet-5": {
      "effortLevel": "medium"
    }
  },
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "custom:tokyonight"
}
